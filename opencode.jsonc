{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["nvidia"],
  "provider": {
    "nvidia-build": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA Build",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "headerTimeout": false,
        "chunkTimeout": 300000,
        "headers": {
          "HTTP-Referer": "https://opencode.ai/",
          "X-Title": "opencode",
          "X-BILLING-INVOKE-ORIGIN": "OpenCode"
        }
      },
      "models": {
        "z-ai/glm-5.2": {
          "name": "GLM 5.2 (NVIDIA) — Agentic workflows, coding, long-horizon reasoning",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "deepseek-ai/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (NVIDIA) — 1M ctx MoE, coding + tool calls",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "deepseek-ai/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (NVIDIA) — 1M ctx, fast + lightweight coding",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "minimaxai/minimax-m2.7": {
          "name": "MiniMax M2.7 (NVIDIA) — 230B coding, reasoning, office tasks",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "minimaxai/minimax-m3": {
          "name": "MiniMax M3 (NVIDIA) — Multimodal VLM, reasoning + tool-calling",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          }
        },
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra (NVIDIA) — Top: agentic reasoning, coding, planning, 1M ctx",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "nvidia/nemotron-3-super-120b-a12b": {
          "name": "Nemotron 3 Super (NVIDIA) — Best P/P: agentic reasoning, coding, planning, 1M ctx",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "meta/llama-3.3-nemotron-super-49b-v1.5": {
          "name": "Llama Nemotron 49B (NVIDIA) — Efficient reasoning, tool calling, chat",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "nvidia/mistral-nemotron": {
          "name": "Mistral Nemotron (NVIDIA) — Agentic workflows, coding, function calling",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "google/gemma-4-31b-it": {
          "name": "Gemma 4 31B (NVIDIA) — Frontier reasoning, coding, budget-friendly",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "nvidia/nemotron-3-nano-30b-a3b": {
          "name": "Nemotron 3 Nano (NVIDIA) — Efficient MoE, 1M ctx, lightweight coding",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
