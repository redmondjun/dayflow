{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nvidia": {
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra (NVIDIA) — Best for complex PRs, architecture, hard bugs. Slowest but smartest.",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "nvidia/nemotron-3-super-120b-a12b": {
          "name": "Nemotron 3 Super (NVIDIA) — Best all-rounder: fixes, features, reviews. Sweet spot of quality vs speed.",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "deepseek-ai/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (NVIDIA) — Strong coding, fast responses. Good for quick fixes and daily dev work.",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "deepseek-ai/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (NVIDIA) — Fastest. Use for simple tasks: triage issues, explain code, quick fixes.",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "nvidia/nemotron-3-nano-30b-a3b": {
          "name": "Nemotron 3 Nano (NVIDIA) — Fastest + cheapest. Use for triage, tiny fixes, quick reviews.",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "z-ai/glm-5.2": {
          "name": "GLM 5.2 (NVIDIA) — Strong for long-context analysis, multi-step agentic workflows.",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "meta/llama-3.3-nemotron-super-49b-v1.5": {
          "name": "Llama Nemotron 49B (NVIDIA) — Solid for general chat, instruction following, tool calling.",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "nvidia/mistral-nemotron": {
          "name": "Mistral Nemotron (NVIDIA) — Reliable agentic coding, good function calling.",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "google/gemma-4-31b-it": {
          "name": "Gemma 4 31B (NVIDIA) — Budget pick: decent reasoning for simple questions.",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "minimaxai/minimax-m3": {
          "name": "MiniMax M3 (NVIDIA) — Can understand images/video. Use for UI/design PR reviews.",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "attachment": true,
          "modalities": { "input": ["text", "image", "video"], "output": ["text"] }
        },
        "minimaxai/minimax-m2.7": {
          "name": "Minimax M2.7 (NVIDIA) — Decent coding for routine tasks, cheaper alternative.",
